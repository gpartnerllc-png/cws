# ============================================================
# DROPPFY — Secrets (NUNCA no HTML / NUNCA no GitHub)
# Copie para .env e preencha. Use só no backend.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://seu-dominio.com

# --- Telegram (avisos de pedido / cadastro) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Correios (contrato oficial) ---
CORREIOS_USER=
CORREIOS_ACCESS_CODE=
CORREIOS_CONTRACT=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_DR=

# --- PIX ---
PIX_KEY=
PIX_BENEFICIARY_NAME=Partner Holding
PIX_CITY=Brasilia

# --- Siscomex / Receita (só após credenciamento + certificado) ---
SISCOMEX_AMBIENTE=homologacao
SISCOMEX_CERT_PATH=
SISCOMEX_CERT_PASSWORD=
# Endpoints conforme documentação oficial do Portal Único (homologação/produção)

# --- Hubs ocultos (cliente NÃO vê) ---
HUB_US_NAME=
HUB_US_STREET=
HUB_US_CITY=
HUB_US_STATE=
HUB_US_ZIP=
HUB_US_PHONE=

HUB_CN_NAME=
HUB_CN_STREET=
HUB_CN_CITY=
HUB_CN_PROVINCE=
HUB_CN_POSTAL=
HUB_CN_PHONE=

# --- Pagamento a agentes (referência operacional) ---
# PayPal / Inter / Nomad / Bitbank — use no painel Admin, não no frontend
AGENT_PAY_NOTE=paypal|inter|nomad|bitbank

# --- Câmbio (opcional API) ---
USD_BRL_FALLBACK=5.50
EXCHANGE_API_KEY=
